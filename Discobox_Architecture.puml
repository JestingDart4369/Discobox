@startuml Discobox_Architecture
skinparam classAttributeIconSize 0

/' ================================================================
   NAMESPACE / UTILITY
   ================================================================ '/

class LedUtil <<namespace>> {
    +{static} hexR(h: uint32_t) : uint8_t
    +{static} hexG(h: uint32_t) : uint8_t
    +{static} hexB(h: uint32_t) : uint8_t
    +{static} hsvToRgb(hue: uint8_t, sat: uint8_t, val: uint8_t) : CRGB
}


/' ================================================================
   LED LAYER
   ================================================================ '/

abstract class LEDBase {
    +{abstract} setup() : void
    +{abstract} show() : void
    +{abstract} clear() : void
    +{abstract} setToColor(r: uint8_t, g: uint8_t, b: uint8_t) : void
    +{abstract} fadeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +{abstract} stepDisco() : void
    +{abstract} showDisco() : void
    +virtual setBrightness(b: uint8_t) : void
    +getBrightness() : uint8_t
    +setToColorHSV(hue: uint8_t, sat: uint8_t, val: uint8_t) : void
    +setToColorHex(hex: uint32_t) : void
    +fadeToColorHSV(hue: uint8_t, sat: uint8_t, val: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +fadeToColorHex(hex: uint32_t, steps: uint16_t, delay_ms: uint16_t) : void
    #_brightness : uint8_t = 255
}

class ILedStrip {
    +{abstract} wipeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +{abstract} setToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t) : void
    +{abstract} fadeToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +wipeToColorHSV(hue: uint8_t, sat: uint8_t, val: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +wipeToColorHex(hex: uint32_t, steps: uint16_t, delay_ms: uint16_t) : void
    +setToColorSingleHSV(i: uint8_t, hue: uint8_t, sat: uint8_t, val: uint8_t) : void
    +setToColorSingleHex(i: uint8_t, hex: uint32_t) : void
    +fadeToColorSingleHSV(i: uint8_t, hue: uint8_t, sat: uint8_t, val: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +fadeToColorSingleHex(i: uint8_t, hex: uint32_t, steps: uint16_t, delay_ms: uint16_t) : void
}

class ARGB <template<DATA_PIN, Led_Number, COLOR_ORDER=GRB>> {
    +ARGB(power_pin: uint8_t = 0xFF)
    +setup() : void
    +show() : void
    +clear() : void
    +setBrightness(b: uint8_t) : void
    +setToColor(r: uint8_t, g: uint8_t, b: uint8_t) : void
    +fadeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +wipeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +setToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t) : void
    +fadeToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +stepDisco() : void
    +showDisco() : void
    +stepLoadingCircle(hue: uint8_t) : void
    +resetLoadingCircle() : void
    +progressStatusLoadingCircle() : uint8_t
    -_leds : CRGB[]
    -_power_pin : uint8_t
    -_loadingStatusprogress : uint8_t
}

class RGBLeds <template<r_pin, g_pin, b_pin, LED_COMMON_ANODE=false>> {
    +RGBLeds()
    +setup() : void
    +show() : void
    +clear() : void
    +setToColor(r: uint8_t, g: uint8_t, b: uint8_t) : void
    +fadeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +stepDisco() : void
    +showDisco() : void
    -_Color : CRGB
    -_LED_COMMON_ANODE : bool
}

LEDBase <|-- ARGB
LEDBase <|-- RGBLeds
ILedStrip <|-- ARGB
ILedStrip <|-- RGBLeds
/' ── WS2805 RGBCCT (lib/WS2805/) ── '/

struct RGBCCT {
    +r : uint8_t
    +g : uint8_t
    +b : uint8_t
    +cw : uint8_t
    +ww : uint8_t
    +RGBCCT(r: uint8_t, g: uint8_t, b: uint8_t, cw: uint8_t, ww: uint8_t)
}

class WS2805Driver {
    +begin() : void
    +show(pixels: const RGBCCT*, count: uint16_t) : void
    -{static} encodeChannel(v: uint8_t, out: uint8_t[3]) : void
    -{static} RESET_BYTES : uint8_t
    -_buf : uint8_t[]
    note "Logger::log() called in begin()\nif LOGGER_H is defined" as N_WS2805Driver
}

class WS2805 <template<Led_Number: uint16_t>> {
    +setup() : void
    +show() : void
    +clear() : void
    +setToColor(r: uint8_t, g: uint8_t, b: uint8_t) : void
    +setToColorCCT(r: uint8_t, g: uint8_t, b: uint8_t, cw: uint8_t, ww: uint8_t) : void
    +setAllWW(brightness: uint8_t) : void
    +setAllCW(brightness: uint8_t) : void
    +fadeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +setToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t) : void
    +fadeToColorSingle(i: uint8_t, r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +wipeToColor(r: uint8_t, g: uint8_t, b: uint8_t, steps: uint16_t, delay_ms: uint16_t) : void
    +stepDisco() : void
    +showDisco() : void
    +flickerBegin() : void
    +flickerUpdate() : void
    -_driver : WS2805Driver
    -_leds : RGBCCT[Led_Number]
    -_flickCurrent : uint8_t[Led_Number]
    -_flickTarget : uint8_t[Led_Number]
    -_sc(v: uint8_t) : uint8_t
    -_scaled(r, g, b, cw, ww: uint8_t) : RGBCCT
    note "Only compiled when LED_CONTROLLER_H\nis defined (LedController.h included first)" as N_WS2805
}

LEDBase  <|-- WS2805
ILedStrip <|-- WS2805
WS2805 *-- WS2805Driver
WS2805Driver ..> RGBCCT


/' ================================================================
   AUDIO LAYER
   ================================================================ '/

struct SongNote {
    +midi : uint8_t
    +duration_ms : uint16_t
    +time_ms : uint32_t
}

struct Song {
    +notes : const SongNote*
    +count : size_t
    +name : const char*
}

class speakerController {
    +speakerController(pin: uint8_t)
    +setup() : void
    +play(notes: const SongNote*, count: size_t) : void
    +playFrom(notes: const SongNote*, count: size_t, offset_ms: uint32_t) : void
    +stop() : void
    +step() : void
    +isPlaying() : bool
    +elapsed() : uint32_t
    +playTone(frequency: uint16_t, duration: uint32_t) : void
    +stopTone() : void
    +playNote(note: uint8_t, duration: uint32_t) : void
    +pitchToFrequency(note: uint8_t) : uint16_t
    +{static} midiToFreq(midi: uint8_t) : uint16_t
    -_pin : uint8_t
    -_notes : const SongNote*
    -_count : size_t
    -_index : size_t
    -_start_ms : uint32_t
    -_playing : bool
}

class BuzzerPlayer {
    +BuzzerPlayer(spk: speakerController&)
    +step() : void
    +play() : void
    +play(index: uint8_t) : void
    +next() : void
    +previous() : void
    +select(index: uint8_t) : void
    +stop() : void
    +autoNext(on: bool) : void
    +playCue(id: UiSfxCueId) : void
    +playCue(name: const char*) : void
    +setCuePack(name: const char*) : void
    +setCuePack(index: uint8_t) : void
    +setCueGap(before_ms: uint16_t, after_ms: uint16_t) : void
    +setMuted(m: bool) : void
    +toggleMute() : void
    +isMuted() : bool
    +isPlaying() : bool
    +songName() : const char*
    +songIndex() : uint8_t
    +songCount() : uint8_t
    +cuePackName() : const char*
    +cuePackIndex() : uint8_t
    +cueGapBefore() : uint16_t
    +cueGapAfter() : uint16_t
    -_spk : speakerController&
    -_index : uint8_t
    -_auto_next : bool
    -_started : bool
    -_ducking : bool
    -_song_paused : bool
    -_song_offset_ms : uint32_t
    -_pack_index : uint8_t
    -_cue_muted : bool
    -_gap_before_ms : uint16_t
    -_gap_after_ms : uint16_t
}

speakerController o-- SongNote
BuzzerPlayer o-- speakerController
BuzzerPlayer o-- Song

class DFPlayerController {
    +DFPlayerController(serial: Stream&)
    +begin(volume: uint8_t) : bool
    +step() : void
    +playFolder(folder: uint8_t, track: uint8_t) : void
    +playFolderLoop(folder: uint8_t) : void
    +pause() : void
    +resume() : void
    +next() : void
    +previous() : void
    +setAutoNext(on: bool) : void
    +setVolume(vol: uint8_t) : void
    +volumeUp() : void
    +volumeDown() : void
    +isOK() : bool
    +isPlaying() : bool
    +trackChanged() : bool
    +currentFolder() : uint8_t
    +currentTrack() : uint8_t
    +volume() : uint8_t
    +playingForMs() : uint32_t
    -_serial : Stream&
    -_player : DFRobotDFPlayerMini
    -_ok : bool
    -_playing : bool
    -_auto_next : bool
    -_folder : uint8_t
    -_track : uint8_t
    -_vol : uint8_t
}


/' ================================================================
   MODES LAYER
   ================================================================ '/

abstract class ModeBase {
    +{abstract} name() : const char*
    +{abstract} color() : uint32_t
    +virtual Enter() : void
    +virtual Exit() : void
    +virtual Step(now: unsigned long) : void
    +virtual SP() : void
    +virtual DP() : void
    +virtual TP() : void
    +virtual cueForSP() : UiSfxCueId
    +virtual cueForDP() : UiSfxCueId
    +virtual cueForTP() : UiSfxCueId
}

class PartyMode {
    +name() : const char*
    +color() : uint32_t
    +Enter() : void
    +Exit() : void
    +Step(now: unsigned long) : void
    +SP() : void
    +DP() : void
    +TP() : void
    +cueForSP() : UiSfxCueId
    +cueForDP() : UiSfxCueId
    +cueForTP() : UiSfxCueId
    +isRunning() : bool
    -_running : bool
    -_last_disco : unsigned long
    -{static} DISCO_STEP_MS : uint16_t
}

class LinkClick {
    +name() : const char*
    +color() : uint32_t
    +Enter() : void
    +Exit() : void
    +Step(now: unsigned long) : void
    +SP() : void
    +DP() : void
    +TP() : void
}

class Mode3 {
    +name() : const char*
    +color() : uint32_t
    +Enter() : void
    +Exit() : void
    +Step(now: unsigned long) : void
    +SP() : void
    +DP() : void
    +TP() : void
}

class Settings {
    +name() : const char*
    +color() : uint32_t
    +Enter() : void
    +Exit() : void
    +Step(now: unsigned long) : void
    +SP() : void
    +DP() : void
    +TP() : void
    +cueForSP() : UiSfxCueId
    +cueForDP() : UiSfxCueId
    +cueForTP() : UiSfxCueId
    -color_settings : uint32_t
    -showSelected() : void
}

class ModeManager {
    +ModeManager(list: ModeBase**, count: uint8_t)
    +begin() : void
    +setMode(index: uint8_t) : void
    +nextMode() : void
    +SP() : void
    +DP() : void
    +TP() : void
    +Step(now: unsigned long) : void
    +current() : ModeBase&
    +index() : uint8_t
    +count() : uint8_t
    -_list : ModeBase**
    -_count : uint8_t
    -_index : uint8_t
    -flashColor(c: uint32_t) : void
}

ModeBase <|-- PartyMode
ModeBase <|-- LinkClick
ModeBase <|-- Mode3
ModeBase <|-- Settings
ModeManager o-- ModeBase


/' ================================================================
   SETTINGS LAYER
   ================================================================ '/

abstract class SettingItem {
    +{abstract} name() : const char*
    +virtual Enter() : void
    +virtual bump() : void
    +virtual cueForBump() : UiSfxCueId
    #virtual logValue() : void
}

class BrightnessSetting {
    +name() : const char*
    +bump() : void
    #logValue() : void
    -{static} STEP : uint8_t
}

class CueMuteSetting {
    +name() : const char*
    +bump() : void
    #logValue() : void
}

class CueThemeSetting {
    +name() : const char*
    +bump() : void
    +cueForBump() : UiSfxCueId
    #logValue() : void
}

class VolumeSetting {
    +name() : const char*
    +bump() : void
    #logValue() : void
    -{static} STEP : uint8_t
}

class SettingsMenu {
    +SettingsMenu(list: SettingItem**, count: uint8_t)
    +begin() : void
    +next() : void
    +previous() : void
    +bump() : void
    +current() : SettingItem&
    +at(i: uint8_t) : SettingItem&
    +index() : uint8_t
    +count() : uint8_t
    -_list : SettingItem**
    -_count : uint8_t
    -_index : uint8_t
}

SettingItem <|-- BrightnessSetting
SettingItem <|-- CueMuteSetting
SettingItem <|-- CueThemeSetting
SettingItem <|-- VolumeSetting
SettingsMenu o-- SettingItem
VolumeSetting ..> DFPlayerController : Audio.setVolume()


/' ================================================================
   STORAGE
   ================================================================ '/

struct PersistedSettings {
    +magic : uint16_t
    +version : uint8_t
    +cuePackIndex : uint8_t
    +gapBeforeMs : uint16_t
    +gapAfterMs : uint16_t
    +muted : uint8_t
    +brightness : uint8_t
    +volume : uint8_t
}

class SettingsStore {
    +{static} MAGIC : uint16_t
    +{static} VERSION : uint8_t
    +load() : void
    +save() : void
}

SettingsStore ..> PersistedSettings


/' ================================================================
   INPUT
   ================================================================ '/

class GestureButton {
    +GestureButton(pin: uint8_t, onSP: Callback, onDP: Callback, onTP: Callback, onHold: Callback)
    +setup() : void
    +update(now: unsigned long) : void
    +isPressed() : bool
    +DEBOUNCE_MS : uint16_t
    +CLICK_GAP_MS : uint16_t
    +HOLD_MS : uint16_t
    -_pin : uint8_t
    -_onSP : Callback
    -_onDP : Callback
    -_onTP : Callback
    -_onHold : Callback
    -_pressed : bool
    -_reading_last : bool
    -_hold_fired : bool
    -_click_count : uint8_t
    -_last_change_ms : unsigned long
    -_press_start_ms : unsigned long
    -_last_release_ms : unsigned long
}


/' ================================================================
   LOGGER
   ================================================================ '/

class Logger {
    +{static} log(fmt: const char*) : void
    +{static} debugLog(fmt: const char*) : void
    +{static} warn(fmt: const char*) : void
    +{static} error(fmt: const char*) : void
    -{static} _print(prefix: const char*, fmt: const char*, args: va_list) : void
}


/' ================================================================
   SERIAL
   ================================================================ '/

class SerialCommander {
    +update() : void
    -{static} BUF_SIZE : uint8_t
    -_buf : char[]
    -_len : uint8_t
    -handle(line: char*) : void
    -{static} toLower(s: char*) : void
    -{static} parseColor(s: const char*, r: uint8_t&, g: uint8_t&, b: uint8_t&) : bool
}

@enduml
